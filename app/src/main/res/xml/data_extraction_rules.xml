<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules.
  Cloud: only the database and settings, and only if the backup is end-to-end
  encrypted with the user's screen lock. Photos/videos are left out (Auto Backup
  caps at 25 MB); the manual .zip export in Settings covers those.
  Device-to-device transfer (setting up a new phone): everything.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
